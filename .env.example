# MEDSTUDY MOZ — variáveis de ambiente
# Copia este ficheiro para .env.local e preenche os valores reais.
# NUNCA faças commit do .env.local.

# --- Supabase (Fase 2) ---
# Públicas: podem chegar ao browser (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: apenas no servidor. Nunca usar o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
