# MEDSTUDY MOZ — variáveis de ambiente
# Copia este ficheiro para .env.local e preenche os valores reais.
# NUNCA faças commit do .env.local.
#
# Onde encontrar os valores (projecto online):
#   Supabase → Project Settings → API Keys
# Para o Supabase local, os valores aparecem em: npm run db:status

# --- Supabase ---
# Públicas: podem chegar ao browser (os dados estão protegidos por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA: apenas no servidor. Nunca usar o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Manuais PDF (Lunes Host) ---
# Opcional mas RECOMENDADO em produção: domínios autorizados para os PDFs,
# separados por vírgulas (ex.: ficheiros.o-seu-dominio.co.mz).
# Vazio = qualquer domínio público https (localhost e redes privadas são sempre bloqueados).
MANUALS_ALLOWED_HOSTS=

# --- Aplicação ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
