# Copie para .env (ou defina estas variáveis no "Setup Node.js App" do cPanel).

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Palavra-passe do painel /admin (use uma forte!)
ADMIN_PASSWORD=

# Segredo para assinar a sessão do painel (texto aleatório longo)
SESSION_SECRET=

# Opcional: modelo do Claude (padrão: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Opcional: porta (na Lunes/Pterodactyl é definida automaticamente)
# PORT=3000
